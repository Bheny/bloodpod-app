generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  supabaseId   String     @unique
  email        String     @unique
  name         String?
  phone        String?
  bloodType    BloodType?
  location     String?
  avatarUrl    String?
  isPublic     Boolean    @default(false)
  // What they said matters to them at sign-up (ids from lib/intents.ts). Empty when not asked.
  intents      String[]   @default([])
  // Get started checklist and first-run tour. Steps are marked done by what the person has actually done;
  // these only record what cannot be seen from the data: steps visited or skipped, hidden, and the tour.
  getStartedSeen        String[]   @default([])
  getStartedDismissedAt DateTime?
  tourSeenAt            DateTime?
  isEligible   Boolean    @default(true)
  isAvailable  Boolean    @default(false)
  lastDonated  DateTime?
  nextEligible DateTime?
  plan         Plan       @default(FREE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Onboarding
  onboardingComplete Boolean @default(false)
  onboardingStep     Int     @default(0)

  // Emergency consent + phone (verification is switched on later)
  emergencyConsentAt DateTime?
  phoneVerifiedAt    DateTime?
  // Set once the donor has answered the last-donation question (even "never").
  donationInfoAt     DateTime?

  // Hospital staff accounts
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  jobTitle   String?

  // Lab staff accounts (the /lab portal)
  labId String?
  lab   Lab?    @relation("LabStaff", fields: [labId], references: [id], onDelete: SetNull)

  // Pod strength tracking
  podStrengthScore Int @default(0) // 0–100

  // Location
  city      String?
  latitude  Float?
  longitude Float?

  // Donation passport tier
  passportTier PassportTier @default(STARTER)

  // Donation streak
  donationStreak Int       @default(0)
  lastStreakDate DateTime?

  // Medical history
  genotype              Genotype?
  allergies             String?
  chronicConditions     String?
  medications           String?
  emergencyContactName  String?
  emergencyContactPhone String?

  ownedPods         Pod[]              @relation("PodOwner")
  podMemberships    PodMember[]        @relation("MemberUser")
  invitedMembers    PodMember[]        @relation("MemberInvitedBy")
  donations         Donation[]
  sentInvites       PodInvite[]        @relation("InviteSender")
  bloodRequests     BloodRequest[]     @relation("Requester")
  activities        Activity[]
  articles          Article[]
  idCards           IdCard[]
  documents         Document[]
  pushSubscriptions PushSubscription[]

  // Care Pod / Case Pod
  careProfiles     CareProfile[]     @relation("CareOwner")
  rotaEntries      RotaEntry[]
  subscriptions    Subscription[]
  payments         Payment[]
  planInterests    PlanInterest[]
  bookings         Booking[]
  notificationLogs NotificationLog[]

  // Asking a donor for help from Discover
  requestsSent     DonorRequest[] @relation("RequestsSent")
  requestsReceived DonorRequest[] @relation("RequestsReceived")

  // Pod readiness
  drillResponses DrillResponse[]
  tendedWeeks    TendedWeek[]
  // The person asked to be left off BloodPod's Garden leaders posters. Everyone else shows by first name only.
  gardenHidden   Boolean @default(false)
}

enum Genotype {
  AA
  AS
  SS
  AC
  SC
  CC
  UNKNOWN
}

model Pod {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  ownerId   String
  owner     User        @relation("PodOwner", fields: [ownerId], references: [id])
  members   PodMember[]
  invites   PodInvite[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // A Pod that grew out of another one (started from someone's invites) points back at it. Set once, never changed.
  parentPodId     String?
  parent          Pod?      @relation("PodLineage", fields: [parentPodId], references: [id], onDelete: SetNull)
  children        Pod[]     @relation("PodLineage")
  spawnedByUserId String?
  // Last drill or real-alert answer from anyone in the Pod.
  lastActivityAt  DateTime?
  drills          Drill[]

  @@index([parentPodId])
}

model PodMember {
  id       String   @id @default(cuid())
  podId    String
  userId   String
  pod      Pod      @relation(fields: [podId], references: [id])
  user     User     @relation("MemberUser", fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  // Who brought this person in (the sender of the invite they used), when known.
  invitedById String?
  invitedBy   User?   @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([podId, userId])
}

model PodInvite {
  id        String       @id @default(cuid())
  podId     String
  pod       Pod          @relation(fields: [podId], references: [id])
  senderId  String
  sender    User         @relation("InviteSender", fields: [senderId], references: [id])
  email     String?
  token     String       @unique @default(cuid())
  code      String       @unique
  kind      InviteKind   @default(DIRECT)
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}

enum InviteKind {
  DIRECT
  SHARE
}

model Donation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  facility  String
  location  String?
  donatedAt DateTime
  bloodType BloodType
  verified  Boolean   @default(false)
  notes     String?
  createdAt DateTime  @default(now())
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum Plan {
  FREE
  PREMIUM
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum PassportTier {
  STARTER // 0–4 donations
  VERIFIED // 5–24 donations
  LEGEND // 25+ donations
}

model BloodRequest {
  id          String         @id @default(cuid())
  podId       String?
  requesterId String
  requester   User           @relation("Requester", fields: [requesterId], references: [id])
  bloodType   BloodType
  urgency     RequestUrgency @default(URGENT)
  facility    String
  location    String?
  message     String?
  status      RequestStatus  @default(OPEN)
  respondedBy String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Activity {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  title     String
  subtitle  String?
  metadata  Json?
  createdAt DateTime     @default(now())
}

enum RequestUrgency {
  STANDARD
  URGENT
  CRITICAL
}

enum RequestStatus {
  OPEN
  MATCHED
  FULFILLED
  CANCELLED
}

enum ActivityType {
  BLOOD_REQUEST
  MEMBER_JOINED
  DONATION_LOGGED
  INVITE_ACCEPTED
  HOSPITAL_VERIFIED
  BADGE_EARNED
}

model Article {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?
  category      ArticleCategory @default(TIP)
  featured      Boolean         @default(false)
  authorName    String          @default("BloodPod Team")
  authorId      String?
  author        User?           @relation(fields: [authorId], references: [id])
  publishedAt   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([publishedAt])
}

enum ArticleCategory {
  TIP
  ARTICLE
  NEWS
  FAQ
}

model Partner {
  id          String      @id @default(cuid())
  name        String
  type        PartnerType @default(HOSPITAL)
  city        String?
  logoUrl     String?
  verified    Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())
}

enum PartnerType {
  HOSPITAL
  BLOOD_BANK
  LAB
}

model IdCard {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  type             IdCardType
  label            String?
  cardNumber       String?
  issuingAuthority String?
  expiryDate       DateTime?
  frontImagePath   String?
  backImagePath    String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

enum IdCardType {
  NATIONAL_ID
  NHIS
  VOTER_ID
  DRIVERS_LICENSE
  PASSPORT
  STUDENT_ID
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  type         DocumentType
  title        String
  filePath     String?
  notes        String?
  documentDate DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum DocumentType {
  MEDICAL_RECORD
  INSURANCE
  VACCINATION
  PRESCRIPTION
  LAB_RESULT
  OTHER
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum HospitalKind {
  HOSPITAL
  CLINIC
  BLOOD_BANK
}

enum HospitalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Hospital {
  id        String         @id @default(cuid())
  name      String
  kind      HospitalKind   @default(HOSPITAL)
  city      String
  address   String
  phone     String
  note      String?
  status    HospitalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Set when an admin approves or rejects the application.
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?

  staff         User[]
  careProfiles  CareProfile[]
  sponsorships  Sponsorship[]
  ledgerEntries LedgerEntry[]
  contracts     Contract[]

  @@index([status])
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum LedgerStatus {
  PAID
  PENDING // invoiced or owed, not yet settled
}

// Manual finance ledger. Amounts are in pesewas (1/100 of a GH₵) to avoid float errors.
model LedgerEntry {
  id            String       @id @default(cuid())
  type          LedgerType
  status        LedgerStatus @default(PAID)
  category      String
  description   String?
  amountPesewas Int
  date          DateTime
  invoiceNo     String?
  hospitalId    String?
  hospital      Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([date])
  @@index([type, status])
}

enum ContractStatus {
  ACTIVE
  PAUSED
  ENDED
}

// A hospital's recurring monthly subscription. Active contracts make up MRR.
model Contract {
  id             String         @id @default(cuid())
  hospitalId     String
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  monthlyPesewas Int
  startsAt       DateTime
  endsAt         DateTime?
  status         ContractStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

// Small key/value store for founder settings, such as opening cash balance.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Care Pod / Case Pod (B2C). Money is integer pesewas. organisationId points at
// Hospital, which is the organisation model in this codebase.
// ─────────────────────────────────────────────────────────────────────────────

enum ConditionType {
  SICKLE_CELL
  THALASSEMIA
  DIALYSIS
  CANCER
  OTHER
}

// Health data. PRIVATE means only the family owner sees conditionType.
enum ConditionVisibility {
  PRIVATE
  SHARED
}

enum CareKind {
  CARE // recurring, monthly
  CASE // planned event, one-off, 90 days
}

model CareProfile {
  id                      String              @id @default(cuid())
  ownerId                 String
  owner                   User                @relation("CareOwner", fields: [ownerId], references: [id])
  podId                   String?
  kind                    CareKind            @default(CARE)
  displayName             String
  conditionType           ConditionType
  conditionVisibility     ConditionVisibility @default(PRIVATE)
  bloodType               BloodType
  // Linked organisation when the hospital is on BloodPod, otherwise free text.
  organisationId          String?
  organisation            Hospital?           @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  hospitalName            String?
  transfusionIntervalDays Int?
  nextTransfusionAt       DateTime?
  donorsNeeded            Int                 @default(2)
  // Case Pod window: 90 days around caseTargetDate. After expiresAt the profile is read-only.
  caseTargetDate          DateTime?
  expiresAt               DateTime?
  consentAt               DateTime
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  transfusionDates TransfusionDate[]
  subscriptions    Subscription[]
  sponsorships     Sponsorship[]

  @@index([ownerId])
  @@index([organisationId])
}

model TransfusionDate {
  id                   String      @id @default(cuid())
  careProfileId        String
  careProfile          CareProfile @relation(fields: [careProfileId], references: [id], onDelete: Cascade)
  organisationId       String?
  scheduledFor         DateTime
  donorsNeeded         Int         @default(2)
  completedAt          DateTime?
  familyReminderSentAt DateTime?
  createdAt            DateTime    @default(now())

  rota RotaEntry[]

  @@index([careProfileId, scheduledFor])
}

enum RotaStatus {
  REQUESTED
  YES
  NO
  EXPIRED
}

model RotaEntry {
  id                String          @id @default(cuid())
  donorId           String
  donor             User            @relation(fields: [donorId], references: [id])
  transfusionDateId String
  transfusionDate   TransfusionDate @relation(fields: [transfusionDateId], references: [id], onDelete: Cascade)
  status            RotaStatus      @default(REQUESTED)
  respondedAt       DateTime?
  remind3dSentAt    DateTime?
  remind1dSentAt    DateTime?
  createdAt         DateTime        @default(now())

  // A donor is asked once per date.
  @@unique([transfusionDateId, donorId])
  @@index([donorId])
}

enum SubscriptionPlan {
  FREE
  BASIC // tools for one person looking after a circle
  PLUS // the same, for a whole family
  CARE // add-on: recurring transfusion planning, per patient
  CASE // add-on: one planned event, 90 days
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String
  user                     User               @relation(fields: [userId], references: [id])
  careProfileId            String?
  careProfile              CareProfile?       @relation(fields: [careProfileId], references: [id], onDelete: SetNull)
  plan                     SubscriptionPlan
  status                   SubscriptionStatus @default(ACTIVE)
  // Failed or cancelled plans keep access until this date, then downgrade.
  currentPeriodEnd         DateTime
  paystackSubscriptionCode String?            @unique
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([userId])
  @@index([careProfileId])
}

enum PaymentKind {
  CARE_SUBSCRIPTION
  CASE_ONE_OFF
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  careProfileId     String?
  amountPesewas     Int
  currency          String        @default("GHS")
  kind              PaymentKind
  paystackReference String        @unique
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
}

enum SponsorshipStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model Sponsorship {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Hospital          @relation(fields: [organisationId], references: [id])
  careProfileId  String
  careProfile    CareProfile       @relation(fields: [careProfileId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         SponsorshipStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())

  @@index([organisationId, status])
  @@index([careProfileId])
}

// Tracks notifications sent per donor so the 3 non-critical alerts a day limit can be enforced.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  critical  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Lab-sponsored donor perks: data model only for now.
model Perk {
  id           String    @id @default(cuid())
  partnerOrgId String?
  title        String
  description  String
  validUntil   DateTime?
  eligibility  String?
  createdAt    DateTime  @default(now())
}

model Lab {
  id             String   @id @default(cuid())
  organisationId String?
  name           String
  town           String
  address        String?
  phone          String?
  // Map position, so the Services page can sort by distance. Listed labs always have one.
  latitude       Float?
  longitude      Float?
  // Hidden from the Services page when false.
  active         Boolean  @default(true)
  // Tests offered, ids from lib/services.ts: [{ "id": "genotype", "pricePesewas": 5000 }]. Price is optional.
  tests          Json
  // The lab pays this commission to BloodPod. The user pays the lab directly.
  commissionRate Decimal  @default(0) @db.Decimal(5, 4)
  createdAt      DateTime @default(now())

  bookings Booking[]
  staff    User[]    @relation("LabStaff")
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  // The lab suggested another time and is waiting for the person to accept.
  RESCHEDULED
  DECLINED
  COMPLETED
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  labId     String
  lab       Lab           @relation(fields: [labId], references: [id])
  testName  String
  genotype  Genotype?
  bloodType BloodType?
  status    BookingStatus @default(REQUESTED)
  createdAt DateTime      @default(now())

  // Every test in the request (ids from lib/service-tests.ts). testName is the readable version.
  testIds       String[]  @default([])
  preferredDate DateTime?
  note          String?
  // When the lab agreed to see them, or proposed to.
  scheduledFor  DateTime?
  labNote       String?
  respondedAt   DateTime?
  completedAt   DateTime?
  // The person agreed to share their name and phone with the lab.
  consentAt     DateTime?

  @@index([userId])
  @@index([labId, status])
}

/// Someone who asked to be told when a paid plan opens. One row per person and plan.
model PlanInterest {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan
  createdAt DateTime         @default(now())

  @@unique([userId, plan])
  @@index([plan])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pod readiness. A leader sends a practice alert to their own Pod to see it would answer.
// Nothing here pays anyone, ranks anyone, or changes who is alerted or in what order.
// ─────────────────────────────────────────────────────────────────────────────

/// A practice alert a Pod leader sends to their own Pod. Never a real emergency.
model Drill {
  id             String    @id @default(cuid())
  podId          String
  pod            Pod       @relation(fields: [podId], references: [id], onDelete: Cascade)
  startedById    String
  startedAt      DateTime  @default(now())
  windowMinutes  Int
  // Eligible members when it started. Fixed then, so later changes cannot change the result.
  eligibleCount  Int
  // Set when the window closes.
  closedAt       DateTime?
  respondedCount Int       @default(0)
  passed         Boolean?

  responses DrillResponse[]

  @@index([podId, startedAt])
}

model DrillResponse {
  id               String   @id @default(cuid())
  drillId          String
  drill            Drill    @relation(fields: [drillId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  respondedAt      DateTime @default(now())
  secondsToRespond Int

  @@unique([drillId, userId])
  @@index([userId])
}

/// One row per person per calendar week in which they did real upkeep for their Pods (the Garden's gardener title).
/// Kept as a ledger of its own, so deleting or merging a Pod never takes earned weeks away.
/// Never read by alerts, listing, search or joining.
model TendedWeek {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monday of the week, midnight UTC.
  weekStart DateTime @db.Date
  /// The highest Garden stage reached that week (0 to 4).
  stage     Int      @default(0)
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Asking one donor for help from Discover. Until the donor accepts, the asker sees only a
// first name. Accepting shares both people's full name and phone with each other, and nothing else.
// ─────────────────────────────────────────────────────────────────────────────

enum DonorRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model DonorRequest {
  id          String             @id @default(cuid())
  seekerId    String
  seeker      User               @relation("RequestsSent", fields: [seekerId], references: [id], onDelete: Cascade)
  donorId     String
  donor       User               @relation("RequestsReceived", fields: [donorId], references: [id], onDelete: Cascade)
  message     String?
  status      DonorRequestStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  // A request nobody answers lapses on its own: PENDING past this is treated as expired.
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([donorId, status])
  @@index([seekerId, createdAt])
}
